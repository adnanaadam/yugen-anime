# ============================================================
# Environment variables - yugen-anime
# Copy this file to .env.local and fill in the values below.
# .env.local is gitignored - never commit real secrets.
# ============================================================

# ------------------------------------------------------------------
# Database
# ------------------------------------------------------------------
# Neon Postgres connection string used by Prisma (prisma.config.ts,
# src/lib/prisma.ts, prisma/seed.ts) via @prisma/adapter-neon.
# Format: postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=

# ------------------------------------------------------------------
# Auth - NextAuth v4 (src/lib/auth.ts)
# ------------------------------------------------------------------
# Google OAuth
# Create credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Discord OAuth
# Create credentials at https://discord.com/developers/applications
# Authorized redirect URI: http://localhost:3000/api/auth/callback/discord
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Secret used to sign/encrypt JWT sessions (NextAuth v4).
# Generate one with: npx auth secret   (or any random 32+ char string)
# Required for production; if unset, NextAuth uses a generated dev secret.
AUTH_SECRET=

# ------------------------------------------------------------------
# Cloudinary - avatar uploads (src/lib/cloudinary.ts)
# ------------------------------------------------------------------
# Find these at https://cloudinary.com/console
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ------------------------------------------------------------------
# Admin
# ------------------------------------------------------------------
# Email allowed to access /admin and the admin API routes
# (compared against the signed-in user's email).
ADMIN_EMAIL=